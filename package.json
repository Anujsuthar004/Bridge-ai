{
  "name": "bridge-ai",
  "displayName": "BridgeAI",
  "version": "0.1.0",
  "description": "Cross-platform context transfer tool for AI chatbots",
  "author": "voola",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.9.3",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.33",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://bard.google.com/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "alarms",
      "clipboardWrite"
    ]
  }
}
